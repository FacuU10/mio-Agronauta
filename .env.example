# Agronautas root environment reference — LOCAL DEVELOPMENT ONLY.
# Keep this file free of credentials. The service-specific examples are
# authoritative: apps/api owns server, database, Redis, worker, and provider
# configuration; apps/web owns only browser-safe and server-side BFF settings.
# Production values MUST come from Render or another secret manager.

NODE_ENV=development
API_PORT=3001
PORT=3000

# API-owned local infrastructure. These values are disposable local defaults.
DATABASE_URL=postgresql://user:password@localhost:5433/appdb
MONGODB_URL=mongodb://localhost:27017/appdb
REDIS_URL=redis://localhost:6379/0
WORKER_POSTGRES_DSN=postgresql://user:password@localhost:5433/appdb
WORKER_REDIS_URL=redis://localhost:6379/0

# Web server-side BFF connection. Browser requests stay same-origin through the BFF.
AGRONAUTAS_API_INTERNAL_URL=http://localhost:3001
AGRONAUTAS_BFF_BEARER_TOKEN=
AGRONAUTAS_BFF_TIMEOUT_MS=30000

# Production-only secret references — inject values at runtime; never commit them.
# HYDROLOGY_INGEST_TOKEN=replace-with-secret-manager-reference
# HYDROLOGY_CRON_OWNER_ID=replace-with-secret-manager-reference
# NASA_FIRMS_API_KEY=replace-with-secret-manager-reference
# SENTINEL_CLIENT_ID=replace-with-secret-manager-reference
# SENTINEL_CLIENT_SECRET=replace-with-secret-manager-reference
# JWT_SECRET=replace-with-secret-manager-reference
