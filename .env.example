# ==============================================================================
# Agronautas Environment Configuration Template (.env.example)
# ==============================================================================
# This file lists all the environment variables required for running the API and
# web services, with safe placeholders. No real secrets should be committed here.

# Database URLs
DATABASE_URL="postgresql://user:password@localhost:5432/appdb"
MONGODB_URL="mongodb://localhost:27017/appdb"
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=3001
NODE_ENV=development
AGRONAUTAS_ROUTE_PREFIX="/agronautas"
AGRONAUTAS_RUNTIME_MODE="real"
TRUST_PROXY=false
READINESS_OPTIONAL_SERVICES="mongodb"
AGRONAUTAS_RUNTIME_REQUIRED=false
AGRONAUTAS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=180

# Schedulers & Jobs
AGRONAUTAS_SCHEDULER_ENABLED=false
HYDROLOGY_SCHEDULER_ENABLED=false
HYDROLOGY_INGEST_TOKEN="replace-with-secret-manager-reference"

# Provider Integrations (Secret Keys)
NASA_FIRMS_API_KEY="replace-with-secret-manager-reference"
SENTINEL_CLIENT_ID="replace-with-secret-manager-reference"
SENTINEL_CLIENT_SECRET="replace-with-secret-manager-reference"

# Frontend Configuration
# Agronautas web talks to the local BFF route `/api/agronautas/*`; keep NEXT_PUBLIC_API_URL unset for production-hardening flows.
AGRONAUTAS_API_INTERNAL_URL="http://localhost:3001"
AGRONAUTAS_BFF_BEARER_TOKEN="replace-with-operator-token"

# Agronautas auth/authz hardening (Deferred to future auth-security library scope)
AGRONAUTAS_AUTH_ENABLED=false
AGRONAUTAS_AUTH_TOKEN_READER="reader-token"
AGRONAUTAS_AUTH_TOKEN_OPERATOR="operator-token"
AGRONAUTAS_AUTH_TOKEN_ADMIN="admin-token"

# Security / JWT
JWT_SECRET="your-secret-key-change-in-production"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
