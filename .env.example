# Database URLs
DATABASE_URL="postgresql://user:password@localhost:5432/appdb"
MONGODB_URL="mongodb://localhost:27017/appdb"
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=3001
NODE_ENV=development
AGRONAUTAS_ROUTE_PREFIX="/agronautas"
AGRONAUTAS_RUNTIME_MODE="real"
TRUST_PROXY=false
READINESS_OPTIONAL_SERVICES="mongodb"
AGRONAUTAS_RUNTIME_REQUIRED=false
AGRONAUTAS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=180

# Frontend Configuration
# Agronautas web talks to the local BFF route `/api/agronautas/*`; keep NEXT_PUBLIC_API_URL unset for production-hardening flows.

# Security
JWT_SECRET="your-secret-key-change-in-production"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
