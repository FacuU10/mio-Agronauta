# Agronautas web environment reference — LOCAL DEVELOPMENT ONLY.
# The browser talks to same-origin BFF routes. This file MUST NOT contain
# DATABASE_URL, Redis/worker settings, provider credentials, or client-secret
# values. API-owned values belong in apps/api/.env.example.

NODE_ENV=development
PORT=3000
AGRONAUTAS_API_INTERNAL_URL=http://localhost:3001
AGRONAUTAS_BFF_TIMEOUT_MS=30000

# Server-side BFF setting. Leave empty locally while API auth is disabled.
AGRONAUTAS_BFF_BEARER_TOKEN=

# Optional browser-visible key; use a provider-restricted public key only.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-public-provider-key

# Production-only: inject the BFF bearer token through the server secret manager.
# Never rename it to NEXT_PUBLIC_* or expose client secret values.
# AGRONAUTAS_BFF_BEARER_TOKEN=replace-with-secret-manager-reference
