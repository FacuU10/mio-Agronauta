{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:security": "eslint . --ext .ts --config .eslintrc.security.json",
    "test": "pnpm run prisma:generate && node --import tsx --test --test-concurrency=1 --test-force-exit src/**/*.test.ts",
    "seed:corrientes-demo": "tsx src/scripts/seed-corrientes-rice-demo.ts --mode=fetch",
    "seed:corrientes-demo:offline": "tsx src/scripts/seed-corrientes-rice-demo.ts --offline-fixtures",
    "seed:corrientes-demo:cleanup": "tsx src/scripts/seed-corrientes-rice-demo.ts --cleanup",
    "seed:government-hydrology": "tsx src/scripts/seed-government-hydrology.ts",
    "verify-local": "tsx src/scripts/verify-hydrology-local-real.ts --all-sources --allow-empty",
    "verify:agronautas:runtime": "tsx src/scripts/verify-agronautas-runtime-real.ts",
    "scheduler:once": "tsx src/scripts/run-hydrology-scheduler-once.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@golden/workflows": "workspace:*",
    "@prisma/client": "^5.10.2",
    "@repo/hydrology-engine": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/zod-schemas": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mongoose": "^8.2.1",
    "opossum": "^8.1.4",
    "pg": "^8.11.3",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "prisma": "^5.10.2",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^3.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
