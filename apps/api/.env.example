# Agronautas API environment reference — LOCAL DEVELOPMENT ONLY.
# This file is the API authority for database, Redis, worker, and server values.
# Use disposable localhost defaults locally. Production values MUST be injected
# by Render or another secret manager and MUST NOT be copied into this file.

NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5433/appdb
REDIS_URL=redis://localhost:6379/0
WORKER_POSTGRES_DSN=postgresql://user:password@localhost:5433/appdb
WORKER_REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017/appdb

CORS_ORIGINS=http://localhost:3000
AGRONAUTAS_ROUTE_PREFIX=/agronautas
AGRONAUTAS_RUNTIME_MODE=real
AGRONAUTAS_RUNTIME_REQUIRED=false
AGRONAUTAS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
AGRONAUTAS_AUTH_ENABLED=false
# Local auth is exercised through explicit test dependency injection. Production
# requires all four values below plus the BFF assertion token from a secret manager.
AGRONAUTAS_AUTH_ACCESS_SECRET=
AGRONAUTAS_AUTH_REFRESH_SECRET=
AGRONAUTAS_AUTH_BOOTSTRAP_SECRET=
AGRONAUTAS_BFF_BEARER_TOKEN=
# Keep bootstrap disabled after the one-time provisioning run. When enabled,
# every input below is required and is consumed only by the internal startup path.
AGRONAUTAS_AUTH_BOOTSTRAP_ENABLED=false
AGRONAUTAS_AUTH_BOOTSTRAP_IDEMPOTENCY_KEY=
AGRONAUTAS_AUTH_BOOTSTRAP_WORKSPACE_NAME=Agronautas Pilot
AGRONAUTAS_AUTH_BOOTSTRAP_ADMIN_EMAIL=
AGRONAUTAS_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AGRONAUTAS_AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=
AGRONAUTAS_AUTH_BOOTSTRAP_FIELD_MAPPINGS=[]
TRUST_PROXY=false
READINESS_OPTIONAL_SERVICES=mongodb

# Keep scheduled work disabled until the worker and its durable store are proved.
AGRONAUTAS_SCHEDULER_ENABLED=false
HYDROLOGY_SCHEDULER_ENABLED=false
HYDROLOGY_INGEST_TOKEN=replace-with-secret-manager-reference

# Optional local-only overrides for an explicitly authorized ingest check.
# HYDROLOGY_INGEST_TOKEN=replace-with-local-ingest-token
# HYDROLOGY_CRON_OWNER_ID=local-development-operator
# AGRONAUTAS_AUTH_TOKEN_READER=replace-with-local-reader-token
# AGRONAUTAS_AUTH_TOKEN_OPERATOR=replace-with-local-operator-token
# AGRONAUTAS_AUTH_TOKEN_ADMIN=replace-with-local-admin-token

# Production-only secret references — inject values at runtime; never commit them.
# HYDROLOGY_INGEST_TOKEN=replace-with-secret-manager-reference
# HYDROLOGY_CRON_OWNER_ID=replace-with-secret-manager-reference
# NASA_FIRMS_API_KEY=replace-with-secret-manager-reference
# SENTINEL_CLIENT_ID=replace-with-secret-manager-reference
# SENTINEL_CLIENT_SECRET=replace-with-secret-manager-reference
# GROQ_API_KEY=replace-with-secret-manager-reference
# JWT_SECRET=replace-with-secret-manager-reference
