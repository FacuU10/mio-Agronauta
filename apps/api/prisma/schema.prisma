// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  low
  medium
  high
}

enum SnapshotFreshness {
  fresh
  stale
  degraded
}

model Field {
  id                String                                      @id @default(cuid())
  externalFieldId   String                                      @unique
  crop              String
  hectares          Decimal                                     @db.Decimal(10, 2)
  localityName      String
  provinceCode      String                                      @default("AR-W")
  centroidLat       Decimal                                     @db.Decimal(10, 7)
  centroidLng       Decimal                                     @db.Decimal(10, 7)
  centroid          Unsupported("geometry(Point,4326)")?
  boundary          Unsupported("geometry(MultiPolygon,4326)")?
  boundaryAreaM2    Decimal?                                    @map("boundary_area_m2") @db.Decimal(18, 3)
  boundaryPerimeterM Decimal?                                   @map("boundary_perimeter_m") @db.Decimal(18, 3)
  geometrySource    String?                                     @map("geometry_source")
  geometryUpdatedAt DateTime?                                   @map("geometry_updated_at")
  boundarySource    Json
  boundaryVersion   String
  createdAt         DateTime                                    @default(now())
  updatedAt         DateTime                                    @updatedAt
  workspaceId       String                                      @map("workspace_id")
  workspace         Workspace                                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fieldContexts     FieldContext[]
  ingestionRuns     SignalIngestionRun[]
  riskSnapshots     RiskSnapshot[]
  alertSnapshots    AlertSnapshot[]
  copilotThreadRefs CopilotThreadRef[]
  jobRuns           AgronautasJobRun[]
  authFieldMapping  AgronautasAuthFieldMapping?
  managementItems   AgronautasManagementItem[]

  @@index([provinceCode, localityName])
  @@index([workspaceId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([centroid], type: Gist)
  @@map("fields")
}

model Workspace {
  id        String   @id
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  fields    Field[]
  managementItems AgronautasManagementItem[]
  marketplaceListings AgronautasMarketplaceListing[]
  marketplaceRfqs AgronautasMarketplaceRfq[]
  marketplaceAudits AgronautasMarketplaceAudit[]

  @@map("agronautas_workspaces")
}

// One additive durable record shape keeps campaign, season, operation, and task
// lifecycle semantics consistent while the kind field preserves the domain boundary.
model AgronautasManagementItem {
  id                 String   @id
  kind               String
  workspaceId        String   @map("workspace_id")
  fieldId            String?  @map("field_id")
  parentId           String?  @map("parent_id")
  name               String
  status             String
  revision           Int      @default(1)
  responsibleActorId String?  @map("responsible_actor_id")
  createdByActorId   String   @map("created_by_actor_id")
  idempotencyKey     String   @map("idempotency_key")
  sourceLocationIds  Json     @map("source_location_ids")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  field              Field?    @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, fieldId, updatedAt(sort: Desc)])
  @@map("agronautas_management_items")
}

model AgronautasManagementAudit {
  auditId        String   @id @map("audit_id")
  workspaceId    String   @map("workspace_id")
  actorId        String   @map("actor_id")
  action         String
  targetId       String   @map("target_id")
  outcome        String
  revisionBefore Int?     @map("revision_before")
  revisionAfter  Int?     @map("revision_after")
  requestId      String   @map("request_id")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([workspaceId, occurredAt(sort: Desc), auditId(sort: Desc)])
  @@index([targetId, occurredAt(sort: Desc)])
  @@map("agronautas_management_audit")
}

// Marketplace records are deliberately non-financial: availability and RFQ handoff
// are persisted without price, order, payment, inventory, or settlement semantics.
model AgronautasMarketplaceListing {
  listingId           String   @id @map("listing_id")
  workspaceId         String   @map("workspace_id")
  marketId            String   @map("market_id")
  participantRef      String   @map("participant_ref")
  itemName            String   @map("item_name")
  title               String
  availabilityStatus  String   @map("availability_status")
  availabilityAt     DateTime @map("availability_at")
  quantity            Decimal? @db.Decimal(18, 3)
  unit                String?
  qualityStatus       String   @map("quality_status")
  sourceKey           String   @map("source_key")
  sourceUrl           String?  @map("source_url") @db.Text
  provenanceRecordedAt DateTime @map("provenance_recorded_at")
  freshnessExpiresAt  DateTime @map("freshness_expires_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, marketId, updatedAt(sort: Desc)])
  @@index([workspaceId, freshnessExpiresAt])
  @@map("agronautas_marketplace_listings")
}

model AgronautasMarketplaceRfq {
  rfqId             String   @id @map("rfq_id")
  workspaceId       String   @map("workspace_id")
  requesterActorId  String   @map("requester_actor_id")
  listingId         String?  @map("listing_id")
  itemName          String   @map("item_name")
  quantity          Decimal  @db.Decimal(18, 3)
  unit              String
  locality          String
  participantRefs   Json     @map("participant_refs")
  reviewStatus      String   @map("review_status")
  revision          Int      @default(1)
  idempotencyKey    String   @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewerActorId   String?  @map("reviewer_actor_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, updatedAt(sort: Desc), rfqId])
  @@index([workspaceId, reviewStatus, updatedAt(sort: Desc)])
  @@map("agronautas_marketplace_rfqs")
}

model AgronautasMarketplaceAudit {
  auditId        String   @id @map("audit_id")
  workspaceId    String   @map("workspace_id")
  actorId        String   @map("actor_id")
  action         String
  targetId       String   @map("target_id")
  outcome        String
  revisionBefore Int?     @map("revision_before")
  revisionAfter  Int?     @map("revision_after")
  requestId      String   @map("request_id")
  occurredAt     DateTime @default(now()) @map("occurred_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt(sort: Desc), auditId])
  @@index([targetId, occurredAt(sort: Desc)])
  @@map("agronautas_marketplace_audit")
}

model FieldContext {
  id                 String   @id @default(cuid())
  fieldId            String
  growthStage        String?
  nearestStationId   String?
  localityCanonical  String
  localityConfidence Decimal  @default(1) @db.Decimal(4, 3)
  contextPayload     Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  field              Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, createdAt(sort: Desc)])
  @@map("field_contexts")
}

model SignalIngestionRun {
  id                String    @id @default(cuid())
  fieldId           String?
  provider          String
  signalType        String
  runId             String    @unique
  status            String
  staleCause        String?
  startedAt         DateTime
  finishedAt        DateTime?
  observedAt        DateTime?
  evidencePayload   Json
  degradationReason String?
  createdAt         DateTime  @default(now())
  field             Field?    @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([provider, signalType, observedAt])
  @@index([fieldId, startedAt(sort: Desc)])
  @@index([fieldId, signalType, status, observedAt(sort: Desc), startedAt(sort: Desc)])
  @@map("signal_ingestion_runs")
}

model AgronautasProviderRun {
  id          String   @id
  runKey      String   @unique @map("run_key")
  runId       String   @unique @map("run_id")
  requestId   String   @map("request_id")
  locationId  String   @map("location_id")
  workspaceId String   @map("workspace_id")
  fieldId     String   @map("field_id")
  provider    String
  signalType  String   @map("signal_type")
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  evidence    AgronautasProviderEvidence[]

  @@index([workspaceId, fieldId, locationId, createdAt(sort: Desc)])
  @@index([provider, signalType, windowStart])
  @@map("agronautas_provider_runs")
}

model AgronautasProviderEvidence {
  id            String                 @id
  providerRunId String                 @map("run_id")
  evidenceId    String                 @unique @map("evidence_id")
  locationId    String                 @map("location_id")
  workspaceId   String                 @map("workspace_id")
  fieldId       String                 @map("field_id")
  provider      String
  signalType    String                 @map("signal_type")
  status        String
  providerMode  String                 @map("provider_mode")
  observedAt    DateTime?              @map("observed_at")
  acquiredAt    DateTime?              @map("acquired_at")
  forecastAt    DateTime?              @map("forecast_at")
  retrievedAt   DateTime               @map("retrieved_at")
  evidencePayload Json                 @map("evidence_payload")
  providerRun   AgronautasProviderRun  @relation(fields: [providerRunId], references: [runId], onDelete: Restrict)

  @@index([workspaceId, fieldId, locationId, retrievedAt(sort: Desc)])
  @@index([provider, signalType, retrievedAt(sort: Desc)])
  @@map("agronautas_provider_evidence")
}

model RiskSnapshot {
  id                 String            @id @default(cuid())
  fieldId            String
  runId              String
  score              Decimal           @db.Decimal(5, 2)
  confidence         Decimal           @db.Decimal(4, 3)
  level              RiskLevel
  freshness          SnapshotFreshness @default(fresh)
  computedAt         DateTime
  validUntil         DateTime
  ruleVersion        String
  staleCause         String?
  degradationReasons Json
  drivers            Json
  evidenceRefs       Json
  summaryPayload     Json
  createdAt          DateTime          @default(now())
  field              Field             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  alertSnapshots     AlertSnapshot[]

  @@index([fieldId, computedAt(sort: Desc)])
  @@index([fieldId, validUntil])
  @@index([runId])
  @@map("risk_snapshots")
}

model AlertSnapshot {
  id                 String            @id @default(cuid())
  fieldId            String
  riskSnapshotId     String
  runId              String
  alertType          String
  priority           Int
  confidence         Decimal           @db.Decimal(4, 3)
  freshness          SnapshotFreshness @default(fresh)
  staleCause         String?
  degradationReasons Json
  payload            Json
  createdAt          DateTime          @default(now())
  field              Field             @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  riskSnapshot       RiskSnapshot      @relation(fields: [riskSnapshotId], references: [id], onDelete: Cascade)

  @@index([fieldId, createdAt(sort: Desc)])
  @@index([fieldId, createdAt(sort: Desc), priority, confidence(sort: Desc)])
  @@index([riskSnapshotId])
  @@unique([fieldId, riskSnapshotId, alertType])
  @@map("alert_snapshots")
}

model CopilotThreadRef {
  id                 String    @id @default(cuid())
  fieldId            String
  externalThreadId   String    @unique
  latestSnapshotId   String?
  latestAlertId      String?
  contextWindowStart DateTime?
  contextWindowEnd   DateTime?
  metadata           Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  field              Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, updatedAt(sort: Desc)])
  @@map("copilot_thread_refs")
}

model AgronautasJobRun {
  id              String   @id @default(cuid())
  jobId           String   @unique
  runId           String
  fieldId         String
  status          String
  triggeredBy     String
  contractVersion String
  requestId       String
  correlationId   String
  runtimeMode     String
  attempt         Int      @default(1)
  maxAttempts     Int      @default(3) @map("max_attempts")
  queuedAt        DateTime
  startedAt       DateTime?
  heartbeatAt     DateTime?
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  leaseOwner      String?  @map("lease_owner")
  retryAt         DateTime? @map("retry_at")
  completedAt     DateTime?
  errorCode       String?
  errorMessage    String?
  terminalErrorCode    String? @map("terminal_error_code")
  terminalErrorMessage String? @map("terminal_error_message")
  deadLetteredAt       DateTime? @map("dead_lettered_at")
  dlqReason            String? @map("dlq_reason")
  resultPayload   Json
  createdAt       DateTime @default(now())
  field           Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, queuedAt(sort: Desc)])
  @@index([fieldId, status, queuedAt(sort: Desc)])
  @@index([status, queuedAt(sort: Desc)])
  @@index([status, retryAt, leaseExpiresAt], map: "agronautas_job_runs_claim_state_idx")
  @@index([runId])
  @@map("agronautas_job_runs")
}

model HydrologyStation {
  id            String                  @id @db.Text
  source        String                  @db.Text
  stationCode   String                  @map("station_code") @db.Text
  stationName   String                  @map("station_name") @db.Text
  riverName     String?                 @map("river_name") @db.Text
  zone          String?                 @db.Text
  provinceCode  String?                 @map("province_code") @db.Text
  countryCode   String                  @map("country_code") @db.Text
  location      Unsupported("geometry(Point,4326)")?
  sourceUrl     String?                 @map("source_url") @db.Text
  isActive      Boolean                 @default(true) @map("is_active")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  ingestionRuns HydrologyIngestionRun[]
  telemetry     HydrologyTelemetry[]

  @@unique([source, stationCode])
  @@index([source, zone], map: "hydrology_stations_source_zone_idx")
  @@index([location], type: Gist, map: "hydrology_stations_location_gix")
  @@map("hydrology_stations")
}

model HydrologyIngestionRun {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source                   String            @db.Text
  proofRunId               String?           @map("proof_run_id") @db.Text
  stationId                String?           @map("station_id") @db.Text
  status                   String            @db.Text
  startedAt                DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt               DateTime?         @map("finished_at") @db.Timestamptz(6)
  observedFrom             DateTime?         @map("observed_from") @db.Timestamptz(6)
  observedTo               DateTime?         @map("observed_to") @db.Timestamptz(6)
  lastSuccessfulObservedAt DateTime?         @map("last_successful_observed_at") @db.Timestamptz(6)
  recordsIngested          Int               @default(0) @map("records_ingested")
  excludedMetrics          String[]          @default([]) @map("excluded_metrics")
  errorMessage             String?           @map("error_message") @db.Text
  provenanceUrl            String?           @map("provenance_url") @db.Text
  iberaRunId               String?           @map("ibera_run_id") @db.Text
  diagnostics              Json              @default("{}")
  station                  HydrologyStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  iberaRun                 IberaIngestRun?   @relation(fields: [iberaRunId], references: [id], onDelete: SetNull)

  @@index([source, startedAt(sort: Desc)], map: "hydrology_ingestion_runs_source_started_idx")
  @@index([proofRunId, source, startedAt(sort: Desc)], map: "hydrology_ingestion_runs_proof_source_started_idx")
  @@index([stationId, startedAt(sort: Desc)], map: "hydrology_ingestion_runs_station_idx")
  @@index([iberaRunId, startedAt(sort: Desc)], map: "hydrology_ingestion_runs_ibera_run_idx")
  @@map("hydrology_ingestion_runs")
}

model IberaIngestRun {
  id              String                  @id @db.Text
  proofRunId      String                  @map("proof_run_id") @db.Text
  status          String                  @db.Text
  requestedSources String[]               @default([]) @map("requested_sources")
  scheduledSlot   String?                 @unique @map("scheduled_slot") @db.Text
  leaseOwner      String?                 @map("lease_owner") @db.Text
  leaseExpiresAt  DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  sourceResults   Json                    @default("[]") @map("source_results")
  diagnostics     Json                    @default("{}")
  reason          String?                 @db.Text
  startedAt       DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?               @map("finished_at") @db.Timestamptz(6)
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  ingestionRuns   HydrologyIngestionRun[]

  @@index([status, expiresAt], map: "ibera_ingest_runs_status_expiry_idx")
  @@index([leaseExpiresAt], map: "ibera_ingest_runs_lease_expiry_idx")
  @@map("ibera_ingest_runs")
}

model HydrologyTelemetry {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId                String           @map("station_id") @db.Text
  source                   String           @db.Text
  metric                   String           @db.Text
  observedAt               DateTime         @map("observed_at") @db.Timestamptz(6)
  ingestedAt               DateTime         @default(now()) @map("ingested_at") @db.Timestamptz(6)
  lastSuccessfulObservedAt DateTime         @map("last_successful_observed_at") @db.Timestamptz(6)
  value                    Decimal?         @db.Decimal
  unit                     String           @db.Text
  tendency                 String?          @db.Text
  forecastHorizonDays      Int?             @map("forecast_horizon_days")
  confidence               String?          @db.Text
  quality                  String           @db.Text
  freshness                String           @db.Text
  sourceUrl                String?          @map("source_url") @db.Text
  raw                      Json             @default("{}")
  station                  HydrologyStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, source, metric, observedAt, forecastHorizonDays])
  @@index([stationId, metric, observedAt(sort: Desc)], map: "hydrology_telemetry_station_metric_observed_idx")
  @@index([source, observedAt(sort: Desc)], map: "hydrology_telemetry_source_observed_idx")
  @@map("hydrology_telemetry")
}

model AgronautasMunicipality {
  id                String                    @id @db.Text
  localityId        String                    @unique @map("locality_id") @db.Text
  name              String                    @db.Text
  provinceCode      String                    @default("AR-W") @map("province_code") @db.Text
  boundary          Unsupported("geometry(MultiPolygon,4326)")
  alertHeightM      Decimal?                  @map("alert_height_m") @db.Decimal(8, 3)
  evacuationHeightM Decimal?                  @map("evacuation_height_m") @db.Decimal(8, 3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  gaugeMapping      MunicipalityGaugeMapping?

  @@index([provinceCode, name], map: "agronautas_municipalities_province_name_idx")
  @@index([boundary], type: Gist, map: "agronautas_municipalities_boundary_gix")
  @@map("agronautas_municipalities")
}

model MunicipalityGaugeMapping {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId      String                  @unique @map("municipality_id") @db.Text
  primaryPnaPortId    String?                 @map("primary_pna_port_id") @db.Text
  secondaryPnaPortIds String[]                @default([]) @map("secondary_pna_port_ids")
  inaStationIds       String[]                @default([]) @map("ina_station_ids")
  smnRegionIds        String[]                @default([]) @map("smn_region_ids")
  inmetStationIds     String[]                @default([]) @map("inmet_station_ids")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  municipality        AgronautasMunicipality  @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@index([secondaryPnaPortIds], type: Gin, map: "municipality_gauge_mappings_secondary_pna_gin")
  @@index([inaStationIds], type: Gin, map: "municipality_gauge_mappings_ina_gin")
  @@index([smnRegionIds], type: Gin, map: "municipality_gauge_mappings_smn_gin")
  @@index([inmetStationIds], type: Gin, map: "municipality_gauge_mappings_inmet_gin")
  @@map("municipality_gauge_mappings")
}

model IberaSourceRegistry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId     String   @map("municipality_id") @db.Text
  source             String   @db.Text
  officialIdentifier String   @map("official_identifier") @db.Text
  stationId          String?  @map("station_id") @db.Text
  coverageKey        String?  @map("coverage_key") @db.Text
  sourceUrl          String   @map("source_url") @db.Text
  freshnessPolicy    String   @map("freshness_policy") @db.Text
  registryVersion    String   @map("registry_version") @db.Text
  reviewStatus       String   @map("review_status") @db.Text
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  geometryStatus     String   @default("unverified") @map("geometry_status") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([municipalityId, source, officialIdentifier], map: "ibera_source_registry_identity_uq")
  @@index([municipalityId, reviewStatus], map: "ibera_source_registry_municipality_review_idx")
  @@index([source, stationId, coverageKey], map: "ibera_source_registry_source_keys_idx")
  @@map("ibera_source_registry")
}

model IberaEvidenceEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId String   @map("municipality_id") @db.Text
  kind           String   @db.Text
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  source         String   @db.Text
  sourceUrl      String?  @map("source_url") @db.Text
  evidenceState  String   @map("evidence_state") @db.Text
  title          String   @db.Text
  detail         String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([municipalityId, occurredAt(sort: Desc), id(sort: Desc)], map: "ibera_evidence_events_bounded_idx")
  @@index([source, occurredAt(sort: Desc)], map: "ibera_evidence_events_source_idx")
  @@map("ibera_evidence_events")
}

model DemoContactSubmission {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  organization  String?
  role          String?
  hectaresRange String?
  locality      String?
  message       String?
  sourcePath    String
  userAgent     String?
  ipHash        String?
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("demo_contact_submissions")
}

model AgronautasAuthWorkspace {
  id          String   @id
  workspaceKey String  @unique @map("workspace_key")
  name        String
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  memberships AgronautasAuthMembership[]
  fieldMappings AgronautasAuthFieldMapping[]

  @@map("agronautas_auth_workspaces")
}

model AgronautasAuthUser {
  id           String   @id
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  sessions     AgronautasAuthSession[]
  memberships  AgronautasAuthMembership[]

  @@map("agronautas_auth_users")
}

model AgronautasAuthSession {
  id              String   @id
  userId          String   @map("user_id")
  membershipId    String   @map("membership_id")
  refreshFamilyId String   @map("refresh_family_id")
  expiresAt       DateTime @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            AgronautasAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership      AgronautasAuthMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  refreshTokens   AgronautasAuthRefreshToken[]

  @@index([userId, expiresAt])
  @@index([refreshFamilyId])
  @@map("agronautas_auth_sessions")
}

model AgronautasAuthRefreshToken {
  id         String   @id
  sessionId  String   @map("session_id")
  familyId   String   @map("family_id")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  session    AgronautasAuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId, expiresAt])
  @@index([sessionId, consumedAt])
  @@map("agronautas_auth_refresh_tokens")
}

model AgronautasAuthMembership {
  id          String   @id
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String
  scopes      Json
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        AgronautasAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   AgronautasAuthWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions    AgronautasAuthSession[]

  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
  @@map("agronautas_auth_memberships")
}

model AgronautasAuthFieldMapping {
  fieldId     String   @id @map("field_id")
  workspaceId String   @map("workspace_id")
  workspaceKey String  @map("workspace_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  workspace   AgronautasAuthWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fieldId])
  @@map("agronautas_auth_field_mappings")
}

model AgronautasAuthBootstrapState {
  singletonId      String   @id @map("singleton_id")
  idempotencyKey   String   @unique @map("idempotency_key")
  inputHash        String   @map("input_hash")
  workspaceId      String   @map("workspace_id")
  adminUserId      String   @map("admin_user_id")
  mappedFieldIds   Json     @map("mapped_field_ids")
  unmappedFieldIds Json     @map("unmapped_field_ids")
  secretConsumedAt DateTime @map("secret_consumed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("agronautas_auth_bootstrap_state")
}
