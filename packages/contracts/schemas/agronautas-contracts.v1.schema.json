{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agronautas.dev/contracts/agronautas-contracts.v1.schema.json",
  "title": "AgronautasContractsV1",
  "description": "Canonical cross-runtime contract catalog for Agronautas MVP foundation slice 1.",
  "type": "object",
  "required": ["contractVersion", "canonicalStrategy", "boundaryMetadata", "degradationReasonCatalog"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "canonicalStrategy": { "const": "json-schema-catalog-v1" },
    "boundaryMetadata": { "$ref": "#/$defs/CorrientesRiceZoneBoundaryMetadata" },
    "degradationReasonCatalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/DegradationReason" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DegradationReason": {
      "type": "string",
      "enum": [
        "weather_data_unavailable",
        "weather_data_stale",
        "satellite_data_unavailable",
        "satellite_data_stale",
        "boundary_source_pending_verification",
        "locality_unverified",
        "manual_context_missing"
      ]
    },
    "CorrientesRiceZoneBoundaryMetadata": {
      "type": "object",
      "required": ["sourceName", "sourceUrl", "sourceVersion", "normalizationStatus", "notes"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "normalizationStatus": { "enum": ["placeholder-pending-ingest", "official-source-referenced"] },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "FieldIntake": {
      "type": "object",
      "required": ["contractVersion", "fieldId", "crop", "hectares", "locality", "location"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cropCategory": { "enum": ["cereal", "oilseed", "horticulture", "forage", "fruit", "other"], "default": "other" },
        "crop": { "enum": ["rice", "maize", "soybean", "wheat", "sunflower", "pasture", "citrus", "other"] },
        "hectares": { "type": "number", "exclusiveMinimum": 0 },
        "locality": { "type": "string", "minLength": 1, "maxLength": 120 },
        "provinceCode": { "const": "AR-W", "default": "AR-W" },
        "countryCode": { "const": "AR", "default": "AR" },
        "growthStage": { "enum": ["emergence", "tillering", "panicle_initiation", "flowering", "maturity"] },
        "location": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 },
            "polygonWkt": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SignalType": { "enum": ["weather", "alert", "satellite_vegetation", "fire", "hydric_soil", "hydrology"] },
    "SignalStatus": { "enum": ["fresh", "stale", "degraded", "missing"] },
    "SignalEvidence": {
      "type": "object",
      "required": ["evidenceId", "provider", "signalType", "observedAt", "ingestedAt", "sourceUrl", "rawHash", "confidence", "freshness", "degradationReasons"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "signalType": { "$ref": "#/$defs/SignalType" },
        "sourceRunId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "observedAt": { "type": "string", "format": "date-time" },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "ingestedAt": { "type": "string", "format": "date-time" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "rawHash": { "type": "string", "minLength": 1, "maxLength": 160 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "$ref": "#/$defs/SignalStatus" },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } }
      },
      "additionalProperties": false
    },
    "SourceCadence": {
      "type": "object",
      "required": ["provider", "signalType", "updateCadence", "rateLimit", "freshnessSla", "researchedAt", "sourceRef"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "signalType": { "$ref": "#/$defs/SignalType" },
        "updateCadence": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rateLimit": { "type": "string", "minLength": 1, "maxLength": 160 },
        "freshnessSla": { "type": "string", "minLength": 1, "maxLength": 80 },
        "researchedAt": { "type": "string", "format": "date-time" },
        "sourceRef": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "SchedulerStatus": {
      "type": "object",
      "required": ["lastRunAt", "nextRunAt", "lockStatus", "failures", "nextDueBySource"],
      "properties": {
        "lastRunAt": { "type": ["string", "null"], "format": "date-time" },
        "nextRunAt": { "type": ["string", "null"], "format": "date-time" },
        "lockStatus": { "enum": ["available", "locked", "unknown"] },
        "failures": { "type": "array", "items": { "type": "object", "required": ["provider", "signalType", "reason"], "properties": { "provider": { "type": "string", "minLength": 1, "maxLength": 80 }, "signalType": { "$ref": "#/$defs/SignalType" }, "reason": { "type": "string", "minLength": 1, "maxLength": 240 } }, "additionalProperties": false } },
        "nextDueBySource": { "type": "array", "items": { "type": "object", "required": ["provider", "signalType", "dueAt", "cadence"], "properties": { "provider": { "type": "string", "minLength": 1, "maxLength": 80 }, "signalType": { "$ref": "#/$defs/SignalType" }, "dueAt": { "type": "string", "format": "date-time" }, "cadence": { "$ref": "#/$defs/SourceCadence" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "RiskDriver": {
      "type": "object",
      "required": ["key", "label", "weight", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "RiskSnapshot": {
      "type": "object",
      "required": ["contractVersion", "snapshotId", "fieldId", "score", "level", "confidence", "computedAt", "validUntil", "ruleVersion", "degradationReasons", "evidenceRefs", "drivers"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "computedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "engineId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceRunIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "acquisitionTimes": { "type": "array", "items": { "type": "string", "format": "date-time" } },
        "alertSnapshotIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "drivers": { "type": "array", "items": { "$ref": "#/$defs/RiskDriver" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "AlertSnapshot": {
      "type": "object",
      "required": ["contractVersion", "alertId", "fieldId", "basedOnSnapshotId", "type", "priority", "confidence", "freshness", "degradationReasons"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "alertId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "basedOnSnapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceRunIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "acquisitionTimes": { "type": "array", "items": { "type": "string", "format": "date-time" } },
        "engineId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["flood", "water_stress", "thermal_stress"] },
        "priority": { "type": "integer", "enum": [1, 2, 3] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "enum": ["fresh", "stale", "degraded"] },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } }
      },
      "additionalProperties": false
    },
    "CopilotSnapshotReference": {
      "type": "object",
      "required": ["snapshotId", "score", "level", "confidence", "freshness", "computedAt", "validUntil", "ruleVersion", "degradationReasons", "evidenceRefs"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "enum": ["fresh", "stale", "degraded"] },
        "computedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "CopilotAlertReference": {
      "type": "object",
      "required": ["alertId", "basedOnSnapshotId", "type", "priority", "confidence", "freshness", "degradationReasons"],
      "properties": {
        "alertId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "basedOnSnapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "enum": ["flood", "water_stress", "thermal_stress"] },
        "priority": { "type": "integer", "enum": [1, 2, 3] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "enum": ["fresh", "stale", "degraded"] },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } }
      },
      "additionalProperties": false
    },
    "CopilotContext": {
      "type": "object",
      "required": ["contractVersion", "fieldId", "crop", "alertIds", "degradationReasons"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "crop": { "enum": ["rice", "maize", "soybean", "wheat", "sunflower", "pasture", "citrus", "other"] },
        "cropCategory": { "enum": ["cereal", "oilseed", "horticulture", "forage", "fruit", "other"] },
        "growthStage": { "enum": ["emergence", "tillering", "panicle_initiation", "flowering", "maturity"] },
        "requestedWindow": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "format": "date-time" },
            "to": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "latestSnapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "alertIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } },
        "snapshot": { "$ref": "#/$defs/CopilotSnapshotReference" },
        "alerts": { "type": "array", "items": { "$ref": "#/$defs/CopilotAlertReference" } }
      },
      "additionalProperties": false
    },
    "DashboardSnapshot": {
      "type": "object",
      "required": ["contractVersion", "snapshotId", "field", "status", "freshness", "signals", "risk", "alerts", "provenance", "scheduler", "generatedAt", "lastDataFetchedAt", "presentation"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "field": { "type": "object", "required": ["fieldId", "cropCategory", "crop", "provinceCode", "locality"], "properties": { "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 }, "cropCategory": { "enum": ["cereal", "oilseed", "horticulture", "forage", "fruit", "other"] }, "crop": { "enum": ["rice", "maize", "soybean", "wheat", "sunflower", "pasture", "citrus", "other"] }, "provinceCode": { "const": "AR-W" }, "locality": { "type": "string", "minLength": 1, "maxLength": 120 } }, "additionalProperties": false },
        "status": { "$ref": "#/$defs/SignalStatus" },
        "freshness": { "$ref": "#/$defs/SignalStatus" },
         "signals": { "type": "array", "items": { "type": "object", "required": ["signalType", "status", "evidenceRefs", "confidence", "degradationReasons"], "properties": { "signalType": { "$ref": "#/$defs/SignalType" }, "status": { "$ref": "#/$defs/SignalStatus" }, "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "sourceRunId": { "type": "string", "minLength": 1, "maxLength": 120 }, "acquisitionTimes": { "type": "array", "items": { "type": "string", "format": "date-time" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "degradationReasons": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } } }, "additionalProperties": false } },
        "risk": { "type": "object", "required": ["score", "level", "confidence", "drivers"], "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "level": { "enum": ["low", "medium", "high"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "drivers": { "type": "array", "items": { "$ref": "#/$defs/RiskDriver" } } }, "additionalProperties": false },
        "alerts": { "type": "array" },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/SignalEvidence" } },
        "scheduler": { "$ref": "#/$defs/SchedulerStatus" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "lastDataFetchedAt": { "type": "string", "format": "date-time" },
         "presentation": {
          "type": "object",
          "required": ["disclaimer", "confidenceLabel", "sourcesUnavailable", "staleFlags"],
          "properties": {
            "disclaimer": { "type": "string", "minLength": 1, "maxLength": 500 },
            "confidenceLabel": { "enum": ["alta", "media", "baja"] },
            "sourcesUnavailable": { "type": "boolean" },
            "staleFlags": { "type": "array", "items": { "$ref": "#/$defs/DegradationReason" } }
          },
          "additionalProperties": false
         },
         "lineage": { "type": "object", "required": ["riskSnapshotId", "sourceRunIds", "acquisitionTimes", "engineId", "engineVersion", "alertSnapshotIds"], "properties": { "riskSnapshotId": { "type": "string", "minLength": 1 }, "sourceRunIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "acquisitionTimes": { "type": "array", "items": { "type": "string", "format": "date-time" } }, "engineId": { "type": "string", "minLength": 1 }, "engineVersion": { "type": "string", "minLength": 1 }, "alertSnapshotIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "ObservationMetadata": {
      "type": "object",
      "required": ["source", "unit", "observedAt", "retrievedAt", "lineage"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 160 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "observedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "lineage": {
          "type": "object",
          "required": ["sourceRunIds", "observationRefs"],
          "properties": {
            "sourceRunIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
            "observationRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AgronautasIntelligence": {
      "type": "object",
      "required": ["contractVersion", "field", "climate", "risk", "soil", "prices", "dollar", "economics", "recommendation", "explanation"],
      "properties": {
        "contractVersion": { "const": "agronautas-intelligence-v1" },
        "field": { "type": "object", "required": ["fieldId", "crop", "hectares", "locality"], "properties": { "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 }, "crop": { "enum": ["rice", "maize", "soybean", "wheat", "sunflower", "pasture", "citrus", "other"] }, "hectares": { "type": "number", "exclusiveMinimum": 0 }, "locality": { "type": "string", "minLength": 1, "maxLength": 120 } }, "additionalProperties": false },
        "climate": { "$ref": "#/$defs/IntelligenceClimateCapability" },
        "risk": { "$ref": "#/$defs/IntelligenceRiskCapability" },
        "soil": { "$ref": "#/$defs/IntelligenceObservationCapability" },
        "prices": { "$ref": "#/$defs/IntelligenceObservationCapability" },
        "dollar": { "$ref": "#/$defs/IntelligenceObservationCapability" },
        "economics": { "$ref": "#/$defs/IntelligenceObservationCapability" },
        "recommendation": { "$ref": "#/$defs/IntelligenceObservationCapability" },
        "explanation": { "type": "object", "required": ["context", "climateTimeline", "riskTimeline", "evidenceRefs"], "properties": { "context": { "type": ["object", "null"] }, "climateTimeline": { "type": "array" }, "riskTimeline": { "type": "array" }, "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 } } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "IntelligenceUnavailableCapability": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": { "state": { "enum": ["unavailable", "insufficient_evidence"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 300 }, "missingInputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 } } },
      "additionalProperties": false
    },
    "IntelligenceObservationCapability": {
      "oneOf": [
        { "type": "object", "required": ["state", "value", "metadata"], "properties": { "state": { "const": "available" }, "value": {}, "metadata": { "$ref": "#/$defs/ObservationMetadata" } }, "additionalProperties": false },
        { "$ref": "#/$defs/IntelligenceUnavailableCapability" }
      ]
    },
    "IntelligenceClimateCapability": {
      "oneOf": [
        { "type": "object", "required": ["state", "value", "metadata"], "properties": { "state": { "const": "available" }, "value": { "type": "object" }, "metadata": { "$ref": "#/$defs/ObservationMetadata" } }, "additionalProperties": false },
        { "$ref": "#/$defs/IntelligenceUnavailableCapability" }
      ]
    },
    "IntelligenceRiskCapability": {
      "oneOf": [
        { "type": "object", "required": ["state", "value", "metadata"], "properties": { "state": { "const": "available" }, "value": { "type": "object" }, "metadata": { "$ref": "#/$defs/ObservationMetadata" } }, "additionalProperties": false },
        { "$ref": "#/$defs/IntelligenceUnavailableCapability" }
      ]
    },
    "PdfReportRequest": {
      "type": "object",
      "required": ["fieldId", "snapshotId"],
      "properties": {
        "fieldId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "AgronautasContractError": {
      "type": "object",
      "required": ["contractVersion", "code", "message", "retryable"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "code": { "enum": ["INVALID_CONTRACT", "OUT_OF_SUPPORTED_AREA", "UNSUPPORTED_CROP", "MISSING_CONTEXT", "STALE_SNAPSHOT", "UNAUTHORIZED", "FORBIDDEN", "WORKER_UNAVAILABLE"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "GroundedChatRequest": {
      "type": "object",
      "required": ["contractVersion", "message"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "comparisonFieldId": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    }
  }
}
