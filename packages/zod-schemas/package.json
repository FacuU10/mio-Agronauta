{
  "name": "@repo/zod-schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc",
    "build:ensure": "node scripts/ensure-build-output.mjs",
    "lint": "eslint . --ext .ts",
    "test": "pnpm run build:ensure && node --import tsx --test package-config.test.mjs src/**/*.test.ts"
  },
  "dependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.11.24",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
