{
  "name": "turborepo-production-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Turborepo monorepo with Next.js 15, Express, and hybrid database strategy",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:security": "turbo run lint:security",
    "verify-local": "pnpm --dir apps/api verify-local",
    "verify:agronautas:runtime": "pnpm --dir apps/api verify:agronautas:runtime",
    "verify:agronautas:browser": "pnpm --dir apps/web test:e2e:agronautas-runtime",
    "worker:install": "python -m pip install -e ./apps/workflow-runtime-python[dev]",
    "worker:test": "python -m pytest apps/workflow-runtime-python/tests -q",
    "worker:run": "python -m worker.main",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && node scripts/clean-root.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5",
    "turbo": "^2.10.3",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
